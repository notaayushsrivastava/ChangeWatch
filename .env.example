# Local development defaults. Never reuse these values for a public deployment.
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min
APP_BASE_URL=http://localhost:8000

# Local quickstart uses SQLite. Docker Compose overrides this to the Postgres service.
# Vercel/production MUST use a managed PostgreSQL URL, e.g. postgresql+psycopg://...
DATABASE_URL=sqlite:///./changewatch.db
QUEUE_TYPE=database
REDIS_URL=redis://localhost:6379/0

# local for a local filesystem/volume; s3 for Vercel/production.
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_DIR=./data/artifacts
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_PREFIX=changewatch
# Optional for AWS-compatible object storage if the runtime identity has no role credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RUN_INLINE_CHECKS=true
ENABLE_INLINE_SCHEDULER=true

BROWSER_NAV_TIMEOUT_SECONDS=30
BROWSER_CHECK_TIMEOUT_SECONDS=60
BROWSER_STABILIZATION_MS=1500
BROWSER_MAX_PAGE_HEIGHT=8000

EMAIL_PROVIDER=console
EMAIL_FROM=alerts@changewatch.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# Generate a valid Fernet key for any public/production deployment.
ENCRYPTION_KEY=replace-with-a-new-fernet-key
LOG_LEVEL=INFO

# Docker Compose only. Use a local-only password and change it if exposing any service.
POSTGRES_DB=changewatch
POSTGRES_USER=changewatch
POSTGRES_PASSWORD=local-only-change-me
