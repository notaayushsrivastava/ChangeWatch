# Local development defaults. Never reuse these values for a public deployment.
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min
APP_BASE_URL=http://localhost:8000

# Local quickstart uses SQLite. Docker Compose overrides this to the Postgres service.
# Vercel/production MUST use managed PostgreSQL. Standard Neon postgresql:// URLs are normalized to psycopg 3 automatically.
DATABASE_URL=sqlite:///./changewatch.db
# Keep this off for normal operation. Temporary recovery only; requires managed PostgreSQL below.
MIGRATE_DATABASE_ON_STARTUP=false
MIGRATION_DATABASE_URL=
QUEUE_TYPE=database
REDIS_URL=redis://localhost:6379/0

# local for a local filesystem/volume; s3 for Vercel/production.
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_DIR=./data/artifacts
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_PREFIX=changewatch
# Optional for AWS-compatible object storage if the runtime identity has no role credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RUN_INLINE_CHECKS=true
ENABLE_INLINE_SCHEDULER=true

BROWSER_NAV_TIMEOUT_SECONDS=30
BROWSER_CHECK_TIMEOUT_SECONDS=60
BROWSER_STABILIZATION_MS=1500
BROWSER_MAX_PAGE_HEIGHT=8000

# Remote Chromium worker. Docker Compose runs one locally; Vercel needs a separately
# hosted HTTPS worker endpoint plus the same shared token configured on both services.
BROWSER_WORKER_URL=
BROWSER_WORKER_TOKEN=local-dev-browser-worker-token-change-me
BROWSER_WORKER_TIMEOUT_SECONDS=45

EMAIL_PROVIDER=console
EMAIL_FROM=alerts@changewatch.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# Generate a valid Fernet key for any public/production deployment.
ENCRYPTION_KEY=dGhpc2lzYXZlcnlzZWNyZXRrZXkxMjM0NTY3ODkwMTI= # local demo key only; generate a new key for deployment
LOG_LEVEL=INFO

# Docker Compose only. Use a local-only password and change it if exposing any service.
POSTGRES_DB=changewatch
POSTGRES_USER=changewatch
POSTGRES_PASSWORD=local-only-change-me
