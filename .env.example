# Environment mode: development, test, production
APP_ENV=development

# Application secret key for session signing and CSRF tokens
APP_SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min

# Base URL of the application
APP_BASE_URL=http://localhost:8000

# Database URL (SQLite WAL for local dev, PostgreSQL for production)
# SQLite example: sqlite:///./changewatch.db
# PostgreSQL example: postgresql://user:password@localhost:5432/changewatch
DATABASE_URL=sqlite:///./changewatch.db

# Task Queue & Scheduler configuration
QUEUE_TYPE=database # Options: 'database', 'redis'
REDIS_URL=redis://localhost:6379/0

# Artifact storage path for screenshots and diffs
ARTIFACT_STORAGE_DIR=./data/artifacts

# Browser worker constraints (seconds)
BROWSER_NAV_TIMEOUT_SECONDS=30
BROWSER_CHECK_TIMEOUT_SECONDS=60
BROWSER_STABILIZATION_MS=1500
BROWSER_MAX_PAGE_HEIGHT=8000

# Email provider: 'console' (prints to log/stdout), 'smtp', 'resend'
EMAIL_PROVIDER=console
EMAIL_FROM=alerts@changewatch.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# Discord Webhook secret encryption key (32 url-safe base64 characters)
ENCRYPTION_KEY=dGhpc2lzYXZlcnlzZWNyZXRrZXkxMjM0NTY3ODkwMTI=

# Logging level
LOG_LEVEL=INFO
